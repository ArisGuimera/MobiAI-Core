# Ensure shell scripts always have LF line endings
*.sh text eol=lf
skills/core/hooks/session-start text eol=lf
skills/core/hooks/update-banner text eol=lf

# Ensure the polyglot wrapper keeps LF (it's parsed by both cmd and bash)
skills/core/hooks/run-hook.cmd text eol=lf

# Common text files
*.md text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
