{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": "./hooks/run-hook.cmd session-start"
      },
      {
        "command": "./hooks/run-hook.cmd update-banner"
      }
    ],
    "postToolUse": [
      {
        "command": "./hooks/run-hook.cmd brain-file-context",
        "matcher": "Read|Write"
      }
    ]
  }
}
